{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "talk-to-figma-mcp": {
      "type": "local",
      "enabled": true,
      "command": [
        "bunx",
        "cursor-talk-to-figma-mcp@latest"
      ]
    },
    "docker-mcp": {
      "type": "local",
      "enabled": true,
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run"
      ]
    },
    "dart-mcp": {
      "type": "local",
      "enabled": true,
      "command": [
        "dart",
        "mcp-server"
      ]
    },
  },
  "plugin": [
    "opencode-antigravity-auth@latest"
  ],
  "provider": {}
}